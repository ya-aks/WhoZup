rules_version = '2';

// ===============================================================
// WhoZup Firestore Security Rules
// Clean, robust permissions for authenticated users across all
// groups, members, statuses, activity, history, invites, and usage.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Users collection (profile data)
    match /users/{userId} {
      allow read, write: if isAuthenticated();
    }

    // Groups collection & all subcollections (members, statuses, activity, history)
    match /groups/{groupId} {
      allow read, write: if isAuthenticated();

      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // Invites collection (group invite code resolution)
    match /invites/{inviteCode} {
      allow read, write: if isAuthenticated();
    }

    // FCM Device Tokens for push notifications
    match /fcmTokens/{userId} {
      allow read, write: if isAuthenticated();
    }

    // Usage counters (event pack balance, created event quotas)
    match /usage/{userId} {
      allow read, write: if isAuthenticated();
    }

    // Default deny for unauthenticated requests
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
